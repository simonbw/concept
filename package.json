{
  "name": "concept",
  "version": "1.0.0",
  "description": "Clone of the board game Concept",
  "scripts": {
    "format": "npx prettier --write ./src/**/*.{ts,tsx}",
    "build": "node esbuild-client.config.mjs",
    "dev": "npm-run-all --parallel dev:*",
    "dev:client": "node esbuild-client.config.mjs --dev",
    "dev:convex": "convex dev",
    "tsc": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonbw/concept.git"
  },
  "author": "Simon Baumgardt-Wellander",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/simonbw/concept/issues"
  },
  "homepage": "https://github.com/simonbw/concept#readme",
  "engines": {
    "npm": "10.x",
    "node": "20.x"
  },
  "prettier": {},
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "@headlessui/tailwindcss": "^0.2.0",
    "@tailwindcss/typography": "^0.5.10",
    "@tanstack/react-query": "^5.17.19",
    "@tippyjs/react": "^4.2.6",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "convex": "^1.17.0",
    "dotenv": "^16.3.1",
    "esbuild": "^0.19.11",
    "esbuild-serve": "^1.0.1",
    "esbuild-style-plugin": "^1.6.3",
    "immutable-assign": "^2.1.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.33",
    "postcss-import": "^16.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "react-tippy": "^1.4.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-opentype": "^1.1.0",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  }
}
